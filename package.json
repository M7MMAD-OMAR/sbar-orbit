{
  "name": "sbar-orbit",
  "version": "0.3.1",
  "description": "Desktop application control for agents, with explicit application and window scope.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M7MMAD-OMAR/sbar-orbit.git"
  },
  "homepage": "https://github.com/M7MMAD-OMAR/sbar-orbit#readme",
  "bugs": {
    "url": "https://github.com/M7MMAD-OMAR/sbar-orbit/issues"
  },
  "type": "module",
  "bin": {
    "sbar-orbit": "bin/sbar-orbit"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "desktop",
    "experiments/ghost-cursor/plugin/ghostinput.cpp",
    "experiments/ghost-cursor/plugin/build.sh",
    "!**/__pycache__",
    "bun.lock",
    "bunfig.toml",
    "install.sh",
    "install.cmd",
    "docs",
    "skills",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "os": [
    "linux",
    "win32",
    "darwin"
  ],
  "keywords": [
    "agent",
    "native",
    "linux",
    "workspace",
    "mcp"
  ],
  "scripts": {
    "verify": "bun --smol run scripts/verify-desktop.ts",
    "verify:platform-contracts": "bun run verify tests/application-discovery.test.ts tests/application-discovery-native.test.ts tests/macos-service-simulation.test.ts tests/service-paths.test.ts tests/preflight.test.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc",
    "orbit": "bun run src/cli.ts",
    "serve": "bun run scripts/limited.ts bun run src/cli.ts serve",
    "check:architecture": "bun run scripts/check-architecture.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@typescript/typescript6": "6.0.2",
    "typescript": "^7.0.2"
  }
}
