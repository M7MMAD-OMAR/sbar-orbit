{
  "name": "sbar-orbit",
  "version": "0.1.0-alpha.9",
  "description": "Local isolated application workspaces for tool-capable AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sbar-orbit": "bin/sbar-orbit"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "desktop",
    "viewer",
    "!**/__pycache__",
    "bun.lock",
    "bunfig.toml",
    "install.sh",
    "install.cmd",
    "docs/*.md",
    "docs/research/**/*.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "os": [
    "linux",
    "win32",
    "darwin"
  ],
  "keywords": [
    "agent",
    "browser",
    "sandbox",
    "wayland",
    "systemd",
    "mcp",
    "playwright",
    "fedora"
  ],
  "scripts": {
    "verify": "bun --smol run scripts/limited.ts bun --smol test",
    "verify:platform-contracts": "bun run verify tests/macos.test.ts tests/macos-keychain.test.ts tests/macos-service-simulation.test.ts tests/platform.test.ts tests/service-paths.test.ts",
    "typecheck": "tsc",
    "orbit": "bun run src/cli.ts",
    "serve": "bun run scripts/limited.ts bun run src/cli.ts serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
