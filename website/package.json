{
  "name": "sbar-orbit-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun node_modules/vite/bin/vite.js",
    "typecheck": "tsc --noEmit",
    "build": "bun node_modules/vite/bin/vite.js build && bun scripts/prerender.tsx",
    "preview": "bun scripts/preview.ts",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "qa": "bun scripts/qa-orbit.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.35",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
