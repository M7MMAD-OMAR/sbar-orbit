{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "esModuleInterop": true, "types": ["bun"]
  },
  "include": ["src", "scripts"]
}
