{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbar-orbit-site",
  "compatibility_date": "2026-09-12",
  // The custom domain is the only address: no public workers.dev URL, so the
  // site is not reachable on a second, unmonitored hostname.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "account_id": "1a81145ac169b887fda4707ea5a759bb",
  "routes": [
    {
      "pattern": "orbit.sbarah.com",
      "custom_domain": true
    }
  ]
}
