+#include <optional>
@@ -56,0 +58 @@ struct SCursor {
+    std::optional<CBox> lastBox;
@@ -207,0 +210,25 @@ static void selectionRequest(void*, wl_protocol_logger_type direction, const wl_
+static std::optional<CBox> cursorBox(const SCursor& cursor) {
+    auto window = cursor.window.lock();
+    if (!window)
+        return std::nullopt;
+    auto surface = window->surfaceLogicalBox();
+    if (!surface)
+        return std::nullopt;
+    return CBox{surface->x + cursor.local.x - 4, surface->y + cursor.local.y - 3, 30, 36};
+}
+
+static void damageCursor(SCursor& cursor) {
+    auto box = cursorBox(cursor);
+    if (cursor.lastBox && box) {
+        const double left = std::min(cursor.lastBox->x, box->x);
+        const double top = std::min(cursor.lastBox->y, box->y);
+        const double right = std::max(cursor.lastBox->x + cursor.lastBox->w, box->x + box->w);
+        const double bottom = std::max(cursor.lastBox->y + cursor.lastBox->h, box->y + box->h);
+        g_pHyprRenderer->damageBox(CBox{left, top, right - left, bottom - top});
+    } else if (box)
+        g_pHyprRenderer->damageBox(*box);
+    else if (cursor.lastBox)
+        g_pHyprRenderer->damageBox(*cursor.lastBox);
+    cursor.lastBox = box;
+}
+
@@ -217,0 +245,2 @@ static void drawCursors(eRenderStage stage) {
+            if (it->second.lastBox)
+                g_pHyprRenderer->damageBox(*it->second.lastBox);
@@ -225 +254 @@ static void drawCursors(eRenderStage stage) {
