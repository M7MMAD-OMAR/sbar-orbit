@@ -1559,0 +1614,51 @@ mod tests {
+    #[tokio::test]
+    async fn owned_dynamic_tool_request_rejects_other_client_and_replay() {
+        let (tx, mut rx) = mpsc::channel::<OutgoingEnvelope>(8);
+        let outgoing = Arc::new(OutgoingMessageSender::new(
+            tx,
+            codex_analytics::AnalyticsEventsClient::disabled(),
+        ));
+        let thread_id = ThreadId::new();
+        let owner = ConnectionId(1);
+        let other = ConnectionId(2);
+        let thread_outgoing = ThreadScopedOutgoingMessageSender::new(
+            outgoing.clone(),
+            vec![owner, other],
+            thread_id,
+        );
+        let payload = ServerRequestPayload::DynamicToolCall(DynamicToolCallParams {
+            thread_id: thread_id.to_string(),
+            turn_id: "turn-1".to_string(),
+            call_id: "call-1".to_string(),
+            namespace: None,
+            tool: "tool".to_string(),
+            arguments: json!({}),
+        });
+        let (id, waiter) = thread_outgoing
+            .send_owned_dynamic_tool_request(payload, Some(owner))
+            .await;
+        assert!(matches!(
+            rx.try_recv(),
+            Ok(OutgoingEnvelope::ToConnection { connection_id, .. }) if connection_id == owner
+        ));
+        assert!(rx.try_recv().is_err());
+        assert!(outgoing.pending_requests_for_thread(thread_id).await.is_empty());
+
+        outgoing
+            .notify_client_response(other, id.clone(), json!({"contentItems": []}))
+            .await;
+        assert!(outgoing.request_id_to_callback.lock().await.contains_key(&id));
+        outgoing
+            .notify_client_response(owner, id.clone(), json!({"contentItems": []}))
+            .await;
+        let result = timeout(Duration::from_secs(1), waiter)
+            .await
+            .expect("owner response should resolve")
+            .expect("owner callback should be present");
+        assert_eq!(result, Ok(json!({"contentItems": []})));
+        outgoing
+            .notify_client_response(other, id, json!({"contentItems": []}))
+            .await;
+        assert!(outgoing.request_id_to_callback.lock().await.is_empty());
+    }
+
