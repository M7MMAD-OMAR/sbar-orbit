diff --git a/codex-rs/app-server/src/thread_state.rs b/codex-rs/app-server/src/thread_state.rs
--- a/codex-rs/app-server/src/thread_state.rs
+++ b/codex-rs/app-server/src/thread_state.rs
@@ -332,0 +333 @@
+    pub(crate) orbit_status_scoped: bool,
@@ -406,0 +408,21 @@
+    pub(crate) async fn status_notification_connection_ids(
+        &self,
+        thread_id: &str,
+    ) -> Vec<ConnectionId> {
+        let state = self.state.lock().await;
+        let subscribed = ThreadId::from_string(thread_id)
+            .ok()
+            .and_then(|thread_id| state.threads.get(&thread_id));
+        state
+            .live_connections
+            .iter()
+            .filter_map(|(connection_id, capabilities)| {
+                (!capabilities.orbit_status_scoped
+                    || subscribed.is_some_and(|thread| {
+                        thread.connection_ids.contains(connection_id)
+                    }))
+                .then_some(*connection_id)
+            })
+            .collect()
+    }
+
