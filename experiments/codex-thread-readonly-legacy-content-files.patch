+    #[derive(PartialEq, Eq)]
+    struct FileSnapshot {
+        bytes: Vec<u8>,
+        modified: SystemTime,
+    }
+
+    fn file_snapshot(path: &Path) -> Option<FileSnapshot> {
+        let metadata = std::fs::metadata(path).ok()?;
+        Some(FileSnapshot {
+            bytes: std::fs::read(path).expect("read fixture file"),
+            modified: metadata.modified().expect("fixture modification time"),
+        })
+    }
+
+    fn sqlite_snapshots(path: &Path) -> Vec<(&'static str, Option<FileSnapshot>)> {
+        ["", "-wal", "-shm"]
+            .into_iter()
+            .map(|suffix| {
+                let mut name = path.as_os_str().to_os_string();
+                name.push(suffix);
+                (suffix, file_snapshot(Path::new(&name)))
+            })
+            .collect()
+    }
+
+    fn assert_files_unchanged(
+        before: &[(&'static str, Option<FileSnapshot>)],
+        after: &[(&'static str, Option<FileSnapshot>)],
+    ) {
+        for ((before_name, before_file), (after_name, after_file)) in before.iter().zip(after) {
+            assert_eq!(before_name, after_name);
+            assert!(
+                before_file == after_file,
+                "state database file {before_name} changed during read-only request"
+            );
+        }
+    }
+
