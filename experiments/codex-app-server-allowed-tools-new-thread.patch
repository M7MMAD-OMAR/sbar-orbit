+#[tokio::test]
+async fn thread_start_allowed_tools_limits_model_inventory() -> Result<()> {
+    let responses = vec![
+        create_final_assistant_message_sse_response("Done")?,
+        create_final_assistant_message_sse_response("Done")?,
+    ];
+    let server = create_mock_responses_server_sequence_unchecked(responses).await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri()).write(codex_home.path())?;
+    let mut app_server = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_auto_env()
+        .build()
+        .await?;
+    timeout(DEFAULT_READ_TIMEOUT, app_server.initialize()).await??;
+
+    for allowed_tools in [json!([{"name": "exec_command"}]), json!([])] {
+        let start_request = app_server
+            .send_raw_request("thread/start", Some(json!({"allowedTools": allowed_tools})))
+            .await?;
+        let start_response = timeout(
+            DEFAULT_READ_TIMEOUT,
+            app_server.read_stream_until_response_message(RequestId::Integer(start_request)),
+        )
+        .await??;
+        let ThreadStartResponse { thread, .. } =
+            to_response::<ThreadStartResponse>(start_response)?;
+        let turn_request = app_server
+            .send_turn_start_request(TurnStartParams {
+                thread_id: thread.id,
+                input: vec![V2UserInput::Text {
+                    text: "Answer briefly".to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            })
+            .await?;
+        let turn_response = timeout(
+            DEFAULT_READ_TIMEOUT,
+            app_server.read_stream_until_response_message(RequestId::Integer(turn_request)),
+        )
+        .await??;
+        let _: TurnStartResponse = to_response::<TurnStartResponse>(turn_response)?;
+        timeout(
+            DEFAULT_READ_TIMEOUT,
+            app_server.read_stream_until_notification_message("turn/completed"),
+        )
+        .await??;
+    }
+
+    let bodies = responses_bodies(&server).await?;
+    assert_eq!(bodies.len(), 2);
+    assert!(find_tool(&bodies[0], "exec_command").is_some());
+    assert!(find_tool(&bodies[0], "view_image").is_none());
+    assert_eq!(bodies[1]["tools"], json!([]));
+    Ok(())
+}
