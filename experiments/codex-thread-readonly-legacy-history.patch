+        assert_eq!(history.items.len(), 2);
+        assert!(history.items.iter().any(|item| {
+            matches!(item, RolloutItem::EventMsg(EventMsg::UserMessage(event)) if event.message == "Hello from user")
+        }));
+        assert!(runtime.get_thread(thread_id).await.expect("read row").is_none());
+        assert_eq!(std::fs::read(&rollout_path).expect("read rollout"), rollout_before);
