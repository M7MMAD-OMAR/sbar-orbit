+    let mut input = stdin.lock();
+    let mut header = String::new();
+    input.read_line(&mut header).expect("read request length");
+    let length: usize = header.trim_end().parse().expect("parse request length");
+    assert!((1..=4096).contains(&length));
+    let mut request_bytes = vec![0; length];
+    input.read_exact(&mut request_bytes).expect("read request body");
+    let request: serde_json::Value =
+        serde_json::from_slice(&request_bytes).expect("parse page request");
+    let thread_id = ThreadId::from_string(
+        request["threadId"].as_str().expect("thread ID must be a string"),
+    )
+    .expect("valid thread ID");
+    let kind = request["kind"].as_str().expect("page kind must be a string");
+    assert!(matches!(kind, "turns" | "items"));
+    let limit = request["limit"].as_u64().expect("page limit must be an integer");
+    assert!((1..=100).contains(&limit));
+    let cursor = match request.get("cursor") {
+        None | Some(serde_json::Value::Null) => None,
+        Some(value) => {
+            let cursor = value.as_str().expect("cursor must be a string");
+            assert!(cursor.len() <= 4096);
+            Some(cursor.to_string())
+        }
+    };
+    let config = test_config(std::path::Path::new("/fixture"));
+    let state_reader = config
+        .sqlite
+        .open_read_only_pool(
+            config.sqlite.state_db_path().as_path(),
+            Some(Duration::from_secs(5)),
+        )
+        .await
+        .expect("open state pool inside bwrap without migration");
+    let selected: (String, String) = sqlx::query_as(
+        "SELECT history_mode, rollout_path FROM threads WHERE id = ?",
+    )
+    .bind(thread_id.to_string())
+    .fetch_one(&state_reader)
+    .await
+    .expect("read selected paginated rollout from state");
+    assert_eq!(selected.0, "paginated");
+    let selected_path = std::path::PathBuf::from(selected.1);
+    let canonical_path = fs::canonicalize(&selected_path).expect("canonical selected rollout");
+    let session_root = fs::canonicalize("/fixture/sessions").expect("canonical sessions root");
+    assert!(canonical_path.starts_with(session_root));
+    assert_eq!(selected_path, canonical_path);
+    state_reader.close().await;
+
+    let history_path = config.sqlite.thread_history_db_path();
+    let reader = sqlx::sqlite::SqlitePoolOptions::new()
+        .max_connections(1)
+        .connect_with(
+            sqlx::sqlite::SqliteConnectOptions::new()
+                .filename(history_path.as_path())
+                .create_if_missing(false)
+                .read_only(true)
+                .busy_timeout(Duration::from_secs(5)),
+        )
+        .await
+        .expect("open page helper pool inside bwrap");
+    let store = LocalThreadStore::new(config, None);
+    let lineage = store
+        .resolve_rollout_lineage_from_selected_rollout(thread_id, selected_path)
+        .await
+        .expect("resolve exact-tag selected rollout lineage");
+    let result = if kind == "turns" {
+        let page = page_turn_rows(
+            &reader,
+            thread_id,
+            &lineage,
+            cursor.as_deref(),
+            limit as usize,
+            SortDirection::Asc,
+            StoredTurnItemsView::Summary,
+        )
+        .await
+        .expect("read turn page");
+        let data = page
+            .rows
+            .into_iter()
+            .map(|row| {
+                let items = row
+                    .summary_items
+                    .iter()
+                    .map(|item| {
+                        serde_json::json!({
+                            "itemId": item.item_id,
+                            "content": serde_json::from_slice::<serde_json::Value>(&item.item_json)
+                                .expect("decode stored item content"),
