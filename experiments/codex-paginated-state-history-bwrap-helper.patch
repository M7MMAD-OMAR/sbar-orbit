+#[tokio::test]
+async fn bwrap_paginated_page_helper_returns_cursor_and_content() {
+    let (home, store, thread_id) = store_with_mode(ThreadHistoryMode::Paginated).await;
+    let original_rollout = rollout_path(home.path(), thread_id);
+    let forked = std::env::var_os("ORBIT_PAGE_HELPER_FORKED").is_some();
+    let selected_rollout_id = if std::env::var_os("ORBIT_PAGE_HELPER_SELECTED_ALTERNATE").is_some() {
+        ThreadId::default()
+    } else {
+        thread_id
+    };
+    assert!(!forked || selected_rollout_id == thread_id);
+    let rollout = rollout_path(home.path(), selected_rollout_id);
+    let fork_root = if forked {
+        let root_id = ThreadId::default();
+        let root_path = rollout_path(home.path(), root_id);
+        write_rollout_with_end(&root_path, root_id, None, 13);
+        let base = history_position(&root_path, root_id, 12);
+        write_rollout_with_end(&rollout, thread_id, Some(base), 10);
+        Some((root_id, root_path))
+    } else {
+        None
+    };
+    if selected_rollout_id != thread_id {
+        write_rollout(&rollout, thread_id, None);
+    }
+    let first_rollout_id = fork_root.as_ref().map_or(selected_rollout_id, |(id, _)| *id);
+    let writer = history_db(&store).await;
+    let _held_writer_connection = writer.acquire().await.expect("hold writer connection");
+    insert_turn(writer, first_rollout_id, "turn-1", 10, "completed", None, Some("user-1"), None).await;
+    insert_item(writer, first_rollout_id, "turn-1", "user-1", 11).await;
+    insert_turn(writer, selected_rollout_id, "turn-2", 20, "completed", None, None, Some("agent-2")).await;
+    insert_item(writer, selected_rollout_id, "turn-2", "agent-2", 21).await;
+    let mounted_rollout = std::path::Path::new("/fixture")
+        .join(rollout.strip_prefix(home.path()).expect("fixture rollout relative path"));
+    let state = store.state_db().await.expect("fixture state runtime");
+    assert!(
+        state
+            .replace_rollout_path_if_current(thread_id, &original_rollout, &mounted_rollout)
+            .await
+            .expect("select mounted rollout path")
+    );
+    let state_path = store.config.sqlite.state_db_path();
+    let history_path = store.config.sqlite.thread_history_db_path();
+    let state_before = history_file_snapshots(state_path.as_path());
+    let before = history_file_snapshots(history_path.as_path());
+    let mut watched_rollouts = vec![original_rollout.clone()];
+    if selected_rollout_id != thread_id {
+        watched_rollouts.push(rollout.clone());
+    }
+    if let Some((_, path)) = &fork_root {
+        watched_rollouts.push(path.clone());
+    }
+    let rollout_before = watched_rollouts
+        .iter()
+        .map(|path| {
+            (
+                fs::read(path).expect("read fixture rollout before helper"),
+                fs::metadata(path)
+                    .expect("rollout metadata before helper")
+                    .modified()
+                    .expect("rollout modified before helper"),
+            )
+        })
+        .collect::<Vec<_>>();
+    assert!(state_before.iter().all(|(_, file)| file.is_some()));
+    assert!(before.iter().all(|(_, file)| file.is_some()));
+
+    let request = |kind: &str, cursor: Option<&str>| serde_json::json!({
+        "kind": kind,
+        "threadId": thread_id.to_string(),
+        "cursor": cursor,
+        "limit": 1,
+    });
+    let first_turn = run_bwrap_page_helper(home.path(), &request("turns", None));
+    assert_eq!(first_turn["data"][0]["turnId"], "turn-1");
+    assert_eq!(first_turn["data"][0]["items"][0]["content"]["content"][0]["text"], "user-1");
+    let turn_cursor = first_turn["nextCursor"].as_str().expect("next turn cursor");
+    let second_turn = run_bwrap_page_helper(home.path(), &request("turns", Some(turn_cursor)));
+    assert_eq!(second_turn["data"][0]["turnId"], "turn-2");
+    assert_eq!(second_turn["data"][0]["items"][0]["content"]["text"], "agent-2 item");
+
+    let first_item = run_bwrap_page_helper(home.path(), &request("items", None));
+    assert_eq!(first_item["data"][0]["itemId"], "user-1");
+    assert_eq!(first_item["data"][0]["content"]["content"][0]["text"], "user-1");
+    let item_cursor = first_item["nextCursor"].as_str().expect("next item cursor");
+    let second_item = run_bwrap_page_helper(home.path(), &request("items", Some(item_cursor)));
+    assert_eq!(second_item["data"][0]["itemId"], "agent-2");
+    assert_eq!(second_item["data"][0]["content"]["text"], "agent-2 item");
+
+    let state_after = history_file_snapshots(state_path.as_path());
+    let after = history_file_snapshots(history_path.as_path());
+    let state_changed = report_history_file_changes("state after page helper", &state_before, &state_after);
+    let history_changed = report_history_file_changes("history after page helper", &before, &after);
+    for (path, (bytes, modified)) in watched_rollouts.iter().zip(rollout_before) {
+        assert_eq!(fs::read(path).expect("read fixture rollout after helper"), bytes);
+        assert_eq!(
+            fs::metadata(path)
+                .expect("rollout metadata after helper")
+                .modified()
+                .expect("rollout modified after helper"),
+            modified,
+        );
+    }
+    if std::env::var_os("ORBIT_PAGE_HELPER_RED_WRITABLE").is_some() {
+        assert!(state_changed || history_changed, "writable mount did not expose a change");
+    } else {
+        assert!(!state_changed, "framed page helper changed state database files");
+        assert!(!history_changed, "framed page helper changed history database files");
+    }
+}
