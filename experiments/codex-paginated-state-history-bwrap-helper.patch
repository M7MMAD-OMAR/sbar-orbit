+fn history_file_snapshots(
+    path: &std::path::Path,
+) -> Vec<(&'static str, Option<HistoryFileSnapshot>)> {
+    ["", "-wal", "-shm"]
+        .into_iter()
+        .map(|suffix| {
+            let mut file_name = path.as_os_str().to_os_string();
+            file_name.push(suffix);
+            let path = std::path::PathBuf::from(file_name);
+            if !path.exists() {
+                return (suffix, None);
+            }
+            let metadata = fs::metadata(&path).expect("history file metadata");
+            let bytes = fs::read(&path).expect("read history file");
+            let digest = Sha256::digest(&bytes);
+            (
+                suffix,
+                Some(HistoryFileSnapshot {
+                    sha256: format!("{digest:x}"),
+                    len: metadata.len(),
+                    modified: metadata.modified().expect("history file modification time"),
+                    readonly: metadata.permissions().readonly(),
+                    bytes,
+                }),
+            )
+        })
+        .collect()
+}
+
+#[derive(PartialEq, Eq)]
+struct HistoryFileSnapshot {
+    sha256: String,
+    len: u64,
+    modified: std::time::SystemTime,
+    readonly: bool,
+    bytes: Vec<u8>,
+}
+
+impl std::fmt::Debug for HistoryFileSnapshot {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("HistoryFileSnapshot")
+            .field("sha256", &self.sha256)
+            .field("len", &self.len)
+            .field("modified", &self.modified)
+            .field("readonly", &self.readonly)
+            .finish()
+    }
+}
+
+fn report_history_file_changes(
+    phase: &str,
+    before: &[(&'static str, Option<HistoryFileSnapshot>)],
+    after: &[(&'static str, Option<HistoryFileSnapshot>)],
+) -> bool {
+    let mut changed = false;
+    for ((before_name, before_file), (after_name, after_file)) in before.iter().zip(after) {
+        assert_eq!(before_name, after_name);
+        let changed_offsets = match (before_file, after_file) {
+            (Some(before_file), Some(after_file)) => Some(
+                before_file
+                    .bytes
+                    .iter()
+                    .zip(&after_file.bytes)
+                    .filter(|(left, right)| left != right)
+                    .count()
+                    + before_file.bytes.len().abs_diff(after_file.bytes.len()),
+            ),
+            _ => None,
+        };
+        eprintln!(
+            "{phase} history{before_name}: before={before_file:?} after={after_file:?} changed_offsets={changed_offsets:?}"
+        );
+        changed |= before_file != after_file;
+    }
+    changed
+}
