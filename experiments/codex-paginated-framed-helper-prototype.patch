+fn run_bwrap_page_helper(
+    fixture_root: &std::path::Path,
+    request: &serde_json::Value,
+) -> serde_json::Value {
+    let request_bytes = serde_json::to_vec(request).expect("serialize page request");
+    assert!(request_bytes.len() <= 4096);
+    let test_binary = std::env::current_exe().expect("current test binary");
+    let mut child = std::process::Command::new("/usr/bin/bwrap")
+        .args([
+            "--die-with-parent",
+            "--unshare-all",
+            "--new-session",
+            "--clearenv",
+            "--ro-bind",
+            "/usr",
+            "/usr",
+            "--symlink",
+            "usr/bin",
+            "/bin",
+            "--symlink",
+            "usr/lib",
+            "/lib",
+            "--symlink",
+            "usr/lib64",
+            "/lib64",
+            "--dev",
+            "/dev",
+            "--proc",
+            "/proc",
+            "--tmpfs",
+            "/tmp",
+            "--ro-bind",
+        ])
+        .arg(fixture_root)
+        .args(["/fixture", "--ro-bind"])
+        .arg(test_binary)
+        .args([
+            "/reader",
+            "--setenv",
+            "HOME",
+            "/tmp",
+            "--setenv",
+            "ORBIT_BWRAP_PAGE_HELPER",
+            "1",
+            "--",
+            "/reader",
+            "bwrap_paginated_page_helper_child",
+            "--nocapture",
+        ])
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .expect("start bwrap page helper");
+    let mut stdin = child.stdin.take().expect("page helper stdin");
+    write!(stdin, "{}\n", request_bytes.len()).expect("write request length");
+    stdin.write_all(&request_bytes).expect("write request body");
+    drop(stdin);
+    let output = child.wait_with_output().expect("wait for bwrap page helper");
+    assert!(
+        output.status.success(),
+        "page helper failed: stdout={} stderr={}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let output_text = std::str::from_utf8(&output.stdout).expect("UTF-8 helper output");
+    let frame = output_text
+        .lines()
+        .find_map(|line| line.strip_prefix("ORBIT_PAGE_RESPONSE:"))
+        .expect("page helper response frame");
+    let (length, body) = frame.split_once(':').expect("response length separator");
+    assert_eq!(length.parse::<usize>().expect("response length"), body.len());
+    serde_json::from_str(body).expect("parse page response")
+}
