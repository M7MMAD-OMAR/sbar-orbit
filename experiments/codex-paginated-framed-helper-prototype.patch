+            rollout_id: thread_id,
+            rollout_path: std::path::PathBuf::from("/fixture/unused-rollout"),
+            start_ordinal: 1,
+            end: None,
+        }],
+    };
+    let result = if kind == "turns" {
+        let page = page_turn_rows(
