+#[tokio::test]
+async fn bwrap_paginated_page_helper_returns_cursor_and_content() {
+    let (home, store, thread_id) = store_with_mode(ThreadHistoryMode::Paginated).await;
+    let writer = history_db(&store).await;
+    let _held_writer_connection = writer.acquire().await.expect("hold writer connection");
+    insert_turn(writer, thread_id, "turn-1", 10, "completed", None, Some("user-1"), None).await;
+    insert_item(writer, thread_id, "turn-1", "user-1", 11).await;
+    insert_turn(writer, thread_id, "turn-2", 20, "completed", None, None, Some("agent-2")).await;
+    insert_item(writer, thread_id, "turn-2", "agent-2", 21).await;
+    let history_path = store.config.sqlite.thread_history_db_path();
+    let before = history_file_snapshots(history_path.as_path());
+    assert!(before.iter().all(|(_, file)| file.is_some()));
+
+    let request = |kind: &str, cursor: Option<&str>| serde_json::json!({
+        "kind": kind,
+        "threadId": thread_id.to_string(),
+        "cursor": cursor,
+        "limit": 1,
+    });
+    let first_turn = run_bwrap_page_helper(home.path(), &request("turns", None));
+    assert_eq!(first_turn["data"][0]["turnId"], "turn-1");
+    assert_eq!(first_turn["data"][0]["items"][0]["content"]["content"][0]["text"], "user-1");
+    let turn_cursor = first_turn["nextCursor"].as_str().expect("next turn cursor");
+    let second_turn = run_bwrap_page_helper(home.path(), &request("turns", Some(turn_cursor)));
+    assert_eq!(second_turn["data"][0]["turnId"], "turn-2");
+    assert_eq!(second_turn["data"][0]["items"][0]["content"]["text"], "agent-2 item");
+
+    let first_item = run_bwrap_page_helper(home.path(), &request("items", None));
+    assert_eq!(first_item["data"][0]["itemId"], "user-1");
+    assert_eq!(first_item["data"][0]["content"]["content"][0]["text"], "user-1");
+    let item_cursor = first_item["nextCursor"].as_str().expect("next item cursor");
+    let second_item = run_bwrap_page_helper(home.path(), &request("items", Some(item_cursor)));
+    assert_eq!(second_item["data"][0]["itemId"], "agent-2");
+    assert_eq!(second_item["data"][0]["content"]["text"], "agent-2 item");
+
+    let after = history_file_snapshots(history_path.as_path());
+    let changed = report_history_file_changes("framed page helper", &before, &after);
+    assert!(!changed, "framed page helper changed owner database files");
+}
 
