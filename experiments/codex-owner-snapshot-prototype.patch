diff --git a/codex-rs/thread-store/src/local/owner_snapshot_prototype.rs b/codex-rs/thread-store/src/local/owner_snapshot_prototype.rs
new file mode 100644
index 0000000..72ee89d
--- /dev/null
+++ b/codex-rs/thread-store/src/local/owner_snapshot_prototype.rs
@@ -0,0 +1,295 @@
+//! Test-only owner snapshot for one standalone paginated thread.
+//! This is not an app-server API or a production admission path.
+
+use std::collections::HashMap;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use codex_protocol::ThreadId;
+use serde_json::Value;
+use sqlx::Connection;
+use sqlx::Row;
+use sqlx::SqliteConnection;
+use sqlx::sqlite::SqliteConnectOptions;
+use tokio::sync::Mutex;
+use tokio::sync::OwnedMutexGuard;
+
+use super::LocalThreadStore;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+#[derive(Clone)]
+pub(super) struct OwnerSnapshotBarrier {
+    local: Arc<Mutex<()>>,
+    path: PathBuf,
+}
+
+pub(super) struct OwnerSnapshotGuard {
+    _local: OwnedMutexGuard<()>,
+    _file: File,
+}
+
+impl OwnerSnapshotBarrier {
+    pub(super) fn new(codex_home: &Path) -> Self {
+        Self {
+            local: Arc::new(Mutex::new(())),
+            path: codex_home.join("owner-snapshot-prototype.lock"),
+        }
+    }
+
+    pub(super) async fn lock(&self) -> ThreadStoreResult<OwnerSnapshotGuard> {
+        let local = self.local.clone().lock_owned().await;
+        let path = self.path.clone();
+        let file = tokio::task::spawn_blocking(move || {
+            let file = OpenOptions::new()
+                .read(true)
+                .write(true)
+                .create(true)
+                .truncate(false)
+                .open(path)?;
+            file.lock()?;
+            Ok::<File, std::io::Error>(file)
+        })
+        .await
+        .map_err(|error| internal(format!("snapshot lock task failed: {error}")))?
+        .map_err(|error| internal(format!("snapshot lock failed: {error}")))?;
+        Ok(OwnerSnapshotGuard {
+            _local: local,
+            _file: file,
+        })
+    }
+}
+
+fn internal(message: String) -> ThreadStoreError {
+    ThreadStoreError::Internal { message }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct SnapshotTurn {
+    pub(super) id: String,
+    pub(super) items: Vec<Value>,
+}
+
+pub(super) struct OwnerSnapshot {
+    generation: ThreadId,
+    pub(super) thread_id: ThreadId,
+    pub(super) title: String,
+    pub(super) section: Option<String>,
+    pub(super) section_position: Option<i64>,
+    pub(super) section_entered_at_ms: Option<i64>,
+    pub(super) rollout_prefix: Vec<u8>,
+    turns: Vec<SnapshotTurn>,
+}
+
+pub(super) struct SnapshotPage {
+    pub(super) turns: Vec<SnapshotTurn>,
+    pub(super) next_cursor: Option<String>,
+}
+
+impl OwnerSnapshot {
+    pub(super) fn page(
+        &self,
+        cursor: Option<&str>,
+        limit: usize,
+    ) -> ThreadStoreResult<SnapshotPage> {
+        if !(1..=50).contains(&limit) {
+            return Err(internal("snapshot page limit is unsupported".to_string()));
+        }
+        let offset = match cursor {
+            None => 0,
+            Some(cursor) => {
+                let (generation, offset) = cursor
+                    .split_once(':')
+                    .ok_or_else(|| internal("snapshot cursor is invalid".to_string()))?;
+                if generation != self.generation.to_string() {
+                    return Err(internal(
+                        "snapshot cursor belongs to another generation".to_string(),
+                    ));
+                }
+                offset
+                    .parse::<usize>()
+                    .map_err(|_| internal("snapshot cursor position is invalid".to_string()))?
+            }
+        };
+        if offset > self.turns.len() {
+            return Err(internal("snapshot cursor exceeds generation".to_string()));
+        }
+        let end = offset.saturating_add(limit).min(self.turns.len());
+        Ok(SnapshotPage {
+            turns: self.turns[offset..end].to_vec(),
+            next_cursor: (end < self.turns.len()).then(|| format!("{}:{end}", self.generation)),
+        })
+    }
+}
+
+impl LocalThreadStore {
+    pub(super) async fn open_owner_snapshot_prototype(
+        &self,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<OwnerSnapshot> {
+        if self.state_db.is_none() {
+            return Err(internal("snapshot needs an initialized state database".to_string()));
+        }
+        let _barrier = self.owner_snapshot_barrier.lock().await?;
+        let state_path = self.config.sqlite.state_db_path();
+        let history_path = self.config.sqlite.thread_history_db_path();
+        let mut state = SqliteConnection::connect_with(
+            &SqliteConnectOptions::new()
+                .filename(state_path)
+                .read_only(true)
+                .create_if_missing(false),
+        )
+        .await
+        .map_err(|error| internal(format!("open state read view failed: {error}")))?;
+        let mut history = SqliteConnection::connect_with(
+            &SqliteConnectOptions::new()
+                .filename(history_path)
+                .read_only(true)
+                .create_if_missing(false),
+        )
+        .await
+        .map_err(|error| internal(format!("open history read view failed: {error}")))?;
+        sqlx::query("BEGIN")
+            .execute(&mut state)
+            .await
+            .map_err(|error| internal(format!("begin state read view failed: {error}")))?;
+        sqlx::query("BEGIN")
+            .execute(&mut history)
+            .await
+            .map_err(|error| internal(format!("begin history read view failed: {error}")))?;
+        let row = sqlx::query(
+            "SELECT rollout_path, history_mode, archived, title, thread_section_id, \
+             section_position, section_entered_at_ms FROM threads WHERE id = ?",
+        )
+        .bind(thread_id.to_string())
+        .fetch_optional(&mut state)
+        .await
+        .map_err(|error| internal(format!("pin state metadata failed: {error}")))?
+        .ok_or_else(|| internal("snapshot thread is missing".to_string()))?;
+        let mode: String = row.get("history_mode");
+        let archived: i64 = row.get("archived");
+        if mode != "paginated" || archived != 0 {
+            return Err(internal("snapshot supports only active paginated threads".to_string()));
+        }
+        let rollout_path: String = row.get("rollout_path");
+        let title: String = row.get("title");
+        let section: Option<String> = row.get("thread_section_id");
+        let section_position: Option<i64> = row.get("section_position");
+        let section_entered_at_ms: Option<i64> = row.get("section_entered_at_ms");
+        let checkpoint = sqlx::query(
+            "SELECT next_rollout_byte_offset, next_rollout_ordinal \
+             FROM thread_history_projection_state WHERE thread_id = ?",
+        )
+        .bind(thread_id.to_string())
+        .fetch_optional(&mut history)
+        .await
+        .map_err(|error| internal(format!("pin history checkpoint failed: {error}")))?
+        .ok_or_else(|| internal("snapshot history checkpoint is missing".to_string()))?;
+        let projected_bytes: i64 = checkpoint.get("next_rollout_byte_offset");
+        let projected_ordinal: i64 = checkpoint.get("next_rollout_ordinal");
+
+        let rollout = Path::new(&rollout_path);
+        let sessions = self.config.codex_home.join("sessions");
+        let valid_name = rollout
+            .file_name()
+            .and_then(|name| name.to_str())
+            .is_some_and(|name| name.ends_with(&format!("-{thread_id}.jsonl")));
+        if !rollout.starts_with(&sessions)
+            || !valid_name
+            || rollout.extension().is_none_or(|ext| ext != "jsonl")
+        {
+            return Err(internal("snapshot rollout shape is unsupported".to_string()));
+        }
+        let canonical_sessions = sessions
+            .canonicalize()
+            .map_err(|error| internal(format!("canonical sessions failed: {error}")))?;
+        let canonical_rollout = rollout
+            .canonicalize()
+            .map_err(|error| internal(format!("canonical rollout failed: {error}")))?;
+        if !canonical_rollout.starts_with(canonical_sessions) {
+            return Err(internal("snapshot rollout escaped sessions".to_string()));
+        }
+        let rollout_bytes = std::fs::read(rollout)
+            .map_err(|error| internal(format!("read snapshot rollout failed: {error}")))?;
+        if rollout_bytes.is_empty()
+            || rollout_bytes.len() > 64 * 1024 * 1024
+            || !rollout_bytes.ends_with(b"\n")
+        {
+            return Err(internal("snapshot rollout has no bounded complete prefix".to_string()));
+        }
+        let mut ordinal = 0_i64;
+        for line in rollout_bytes.split(|byte| *byte == b'\n').filter(|line| !line.is_empty()) {
+            let value: Value = serde_json::from_slice(line)
+                .map_err(|error| internal(format!("invalid rollout line: {error}")))?;
+            if value.get("ordinal").and_then(Value::as_i64) != Some(ordinal) {
+                return Err(internal("snapshot rollout ordinal is unsupported".to_string()));
+            }
+            if ordinal == 0
+                && (value.get("type").and_then(Value::as_str) != Some("session_meta")
+                    || value.pointer("/payload/id").and_then(Value::as_str)
+                        != Some(thread_id.to_string().as_str())
+                    || value.pointer("/payload/history_mode").and_then(Value::as_str)
+                        != Some("paginated")
+                    || value.pointer("/payload/history_base").is_some_and(|base| !base.is_null()))
+            {
+                return Err(internal("snapshot rollout lineage is unsupported".to_string()));
+            }
+            ordinal += 1;
+        }
+        if projected_bytes != rollout_bytes.len() as i64 || projected_ordinal != ordinal {
+            return Err(internal("snapshot history projection lags rollout".to_string()));
+        }
+        let rows = sqlx::query(
+            "SELECT turn_id FROM thread_turns WHERE thread_id = ? ORDER BY rollout_ordinal",
+        )
+        .bind(thread_id.to_string())
+        .fetch_all(&mut history)
+        .await
+        .map_err(|error| internal(format!("snapshot turn read failed: {error}")))?;
+        let mut turns = rows
+            .into_iter()
+            .map(|row| SnapshotTurn {
+                id: row.get("turn_id"),
+                items: Vec::new(),
+            })
+            .collect::<Vec<_>>();
+        let positions = turns
+            .iter()
+            .enumerate()
+            .map(|(index, turn)| (turn.id.clone(), index))
+            .collect::<HashMap<_, _>>();
+        let items = sqlx::query(
+            "SELECT turn_id, item_json FROM thread_items \
+             WHERE thread_id = ? ORDER BY rollout_ordinal",
+        )
+        .bind(thread_id.to_string())
+        .fetch_all(&mut history)
+        .await
+        .map_err(|error| internal(format!("snapshot item read failed: {error}")))?;
+        for item in items {
+            let turn_id: String = item.get("turn_id");
+            let index = positions
+                .get(&turn_id)
+                .copied()
+                .ok_or_else(|| internal("snapshot item has no turn".to_string()))?;
+            let item_json: String = item.get("item_json");
+            turns[index].items.push(
+                serde_json::from_str(&item_json)
+                    .map_err(|error| internal(format!("snapshot item JSON failed: {error}")))?,
+            );
+        }
+        Ok(OwnerSnapshot {
+            generation: ThreadId::new(),
+            thread_id,
+            title,
+            section,
+            section_position,
+            section_entered_at_ms,
+            rollout_prefix: rollout_bytes,
+            turns,
+        })
+    }
+}
