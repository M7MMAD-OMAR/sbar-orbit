+#[tokio::test]
+async fn owner_snapshot_prototype_keeps_cursor_pages_on_one_generation() {
+    let home = TempDir::new().expect("temp dir");
+    let store = projection_store(home.path()).await;
+    let thread_id = ThreadId::new();
+    create_paginated_thread(&store, thread_id).await;
+    store
+        .persist_thread(thread_id, PersistContext::Standard)
+        .await
+        .expect("persist session metadata");
+    let rollout_path = store
+        .live_rollout_path(thread_id)
+        .await
+        .expect("fixture rollout path");
+    let state = store.state_db().await.expect("fixture state database");
+    codex_rollout::state_db::reconcile_rollout(
+        Some(state.as_ref()),
+        rollout_path.as_path(),
+        "test-provider",
+        /*builder*/ None,
+        &[],
+        /*archived_only*/ None,
+        /*new_thread_memory_mode*/ None,
+    )
+    .await;
+    assert!(
+        state
+            .get_thread(thread_id)
+            .await
+            .expect("read fixture metadata")
+            .is_some(),
+        "fixture state row must exist before opening a snapshot"
+    );
+
+    let items = |turn_id: &str, user_id: &str| {
+        vec![
+            turn_started(turn_id),
+            completed_item(
+                thread_id,
+                turn_id,
+                TurnItem::UserMessage(UserMessageItem {
+                    id: user_id.to_string(),
+                    client_id: None,
+                    content: Vec::new(),
+                }),
+            ),
+            turn_completed(turn_id),
+        ]
+    };
+    for (turn_id, user_id) in [("turn-1", "user-1"), ("turn-2", "user-2")] {
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id,
+                items: items(turn_id, user_id),
+            })
+            .await
+            .expect("append first generation");
+    }
+
+    let snapshot = store
+        .open_owner_snapshot_prototype(thread_id)
+        .await
+        .expect("open owner snapshot");
+    let first = snapshot.page(None, 1).expect("first cursor page");
+    assert_eq!(first.turns[0].id, "turn-1");
+    assert_eq!(first.turns[0].items.len(), 1);
+    let cursor = first.next_cursor.expect("first cursor");
+
+    let held = store
+        .owner_snapshot_barrier
+        .lock()
+        .await
+        .expect("hold owner barrier");
+    let pending = store.append_items(AppendThreadItemsParams {
+        thread_id,
+        items: items("turn-3", "user-3"),
+    });
+    tokio::pin!(pending);
+    assert!(tokio::time::timeout(Duration::from_millis(50), &mut pending)
+        .await
+        .is_err());
+    drop(held);
+    pending.await.expect("owner append after release");
+
+    let second = snapshot.page(Some(&cursor), 2).expect("second cursor page");
+    assert_eq!(
+        second.turns.iter().map(|turn| turn.id.as_str()).collect::<Vec<_>>(),
+        vec!["turn-2"]
+    );
+    assert_eq!(second.turns[0].items.len(), 1);
+    assert!(second.next_cursor.is_none());
+    let fresh = store
+        .open_owner_snapshot_prototype(thread_id)
+        .await
+        .expect("open new owner generation");
+    assert!(fresh.page(Some(&cursor), 2).is_err());
+    let newest = fresh.page(None, 3).expect("new generation page");
+    assert_eq!(
+        newest.turns.iter().map(|turn| turn.id.as_str()).collect::<Vec<_>>(),
+        vec!["turn-1", "turn-2", "turn-3"]
+    );
+    assert_eq!(newest.turns[2].items.len(), 1);
+    assert_eq!(snapshot.thread_id, thread_id);
+    assert!(snapshot.rollout_prefix.len() < fresh.rollout_prefix.len());
+    assert!(fresh.rollout_prefix.starts_with(&snapshot.rollout_prefix));
+    assert_eq!(snapshot.title, fresh.title);
+
+    let held = store
+        .owner_snapshot_barrier
+        .lock()
+        .await
+        .expect("hold barrier across metadata update");
+    let pending = store.update_thread_metadata(UpdateThreadMetadataParams {
+        thread_id,
+        patch: ThreadMetadataPatch {
+            title: Some("Renamed owner generation".to_string()),
+            ..Default::default()
+        },
+        include_archived: false,
+    });
+    tokio::pin!(pending);
+    assert!(tokio::time::timeout(Duration::from_millis(50), &mut pending)
+        .await
+        .is_err());
+    drop(held);
+    pending.await.expect("metadata write after release");
+    let renamed = store
+        .open_owner_snapshot_prototype(thread_id)
+        .await
+        .expect("open generation after title update");
+    assert_eq!(renamed.title, "Renamed owner generation");
+    assert_eq!(fresh.title, snapshot.title);
+
+    let held = store
+        .owner_snapshot_barrier
+        .lock()
+        .await
+        .expect("hold barrier across section move");
+    let pending = store.move_thread_to_section(MoveThreadToSectionParams {
+        thread_id,
+        section: Some(codex_state::PINNED_THREAD_SECTION_ID.to_string()),
+        before_thread_id: None,
+    });
+    tokio::pin!(pending);
+    assert!(tokio::time::timeout(Duration::from_millis(50), &mut pending)
+        .await
+        .is_err());
+    drop(held);
+    pending.await.expect("section move after release");
+    let pinned = store
+        .open_owner_snapshot_prototype(thread_id)
+        .await
+        .expect("open generation after section move");
+    assert_eq!(renamed.section, None);
+    assert_eq!(pinned.section.as_deref(), Some(codex_state::PINNED_THREAD_SECTION_ID));
+    assert!(pinned.section_position.is_some());
+    assert!(pinned.section_entered_at_ms.is_some());
+
+    store
+        .shutdown_thread(thread_id)
+        .await
+        .expect("release live writer before archive");
+    let held = store
+        .owner_snapshot_barrier
+        .lock()
+        .await
+        .expect("hold barrier across archive");
+    let pending = store.archive_thread(ArchiveThreadParams { thread_id });
+    tokio::pin!(pending);
+    assert!(tokio::time::timeout(Duration::from_millis(50), &mut pending)
+        .await
+        .is_err());
+    drop(held);
+    pending.await.expect("archive after release");
+    assert_eq!(pinned.page(None, 3).expect("old archived generation page").turns.len(), 3);
+    assert!(store.open_owner_snapshot_prototype(thread_id).await.is_err());
+}
