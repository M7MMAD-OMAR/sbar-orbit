#!/usr/bin/env bash
set -euo pipefail

# Resolve relative symlinks with the readlink interface shared by Linux and macOS.
orbit_script=${BASH_SOURCE[0]}
for ((orbit_link_count=0; ; orbit_link_count++)); do
  orbit_directory=$(cd -P -- "$(dirname -- "$orbit_script")" && pwd) || exit 1
  orbit_script="$orbit_directory/$(basename -- "$orbit_script")"
  [ -L "$orbit_script" ] || break
  if [ "$orbit_link_count" -ge 40 ]; then
    echo "sbar-orbit: too many symbolic links" >&2
    exit 1
  fi
  orbit_target=$(readlink "$orbit_script") || exit 1
  case "$orbit_target" in
    /*) orbit_script=$orbit_target ;;
    *) orbit_script="$orbit_directory/$orbit_target" ;;
  esac
done
orbit_root=$(dirname -- "$(dirname -- "$orbit_script")")
orbit_uname=$(uname -s)

# The GTK surfaces below use Python and are Linux only here. Spawning
# `/usr/bin/python3` on macOS is not merely useless: that path is a stub that raises the Command Line
# Tools installer dialog on a machine without them, which puts a system window on the person's screen.
# docs/porting.md lists it among the calls Orbit will not make on darwin, so the refusal is explicit
# and names what does exist instead.
orbit_refuse_desktop() {
  cat >&2 <<REFUSED
sbar-orbit $1 is a Linux desktop surface and does not exist on $orbit_uname.

The panel and the settings window are GTK, and Orbit will not spawn /usr/bin/python3 here: on macOS
that path can raise the Command Line Tools installer as a window on your screen.

Native desktop support on this platform is not implemented. Metadata commands remain available:

  sbar-orbit status
  sbar-orbit doctor
REFUSED
  exit 64
}

# Bun by absolute location, not by the caller's PATH. A systemd user service starts this launcher with
# the manager's own PATH, which has no ~/.bun/bin in it: measured on an Ubuntu runner on 14 September
# 2026, where the service exited 127 on every restart while the same launcher worked from the shell.
if [ "${ORBIT_BUN+x}" = x ]; then
  case "$ORBIT_BUN" in
    /*) ;;
    *) echo "sbar-orbit: the pinned ORBIT_BUN runtime must be an absolute executable path" >&2; exit 127 ;;
  esac
  if [ ! -x "$ORBIT_BUN" ]; then
    echo "sbar-orbit: the pinned ORBIT_BUN runtime is unavailable; reinstall with the intended Bun runtime" >&2
    exit 127
  fi
  orbit_bun=$ORBIT_BUN
else
  orbit_bun=$(command -v bun 2>/dev/null || true)
  for orbit_candidate in "${BUN_INSTALL:-$HOME/.bun}/bin/bun" "$HOME/.bun/bin/bun" /usr/local/bin/bun /usr/bin/bun; do
    if [ -z "$orbit_bun" ] && [ -x "$orbit_candidate" ]; then orbit_bun=$orbit_candidate; fi
  done
fi
if [ -z "$orbit_bun" ]; then
  echo "sbar-orbit: bun was not found on PATH, in ~/.bun/bin, /usr/local/bin or /usr/bin; install Bun 1.3 or newer" >&2
  exit 127
fi
export PATH="$(dirname -- "$orbit_bun"):$PATH"

case "${1:-help}" in
  help|--help|-h)
    cat <<'HELP'
Sbar Orbit, desktop application control for your AI agent

  sbar-orbit install             Do the whole installation in one command
  sbar-orbit install --dry-run   Show every step without changing anything
  sbar-orbit install --native    Also build the private display runtime for native sessions
  sbar-orbit serve               Start the broker with shared resource limits
  sbar-orbit serve --managed-socket
                                 Bind the fixed socket a service unit expects
  sbar-orbit service install     Install the units and start Orbit with your desktop
  sbar-orbit service install --no-autostart
                                 Write the units and enable nothing
  sbar-orbit service uninstall   Remove only the units Orbit wrote
  sbar-orbit autostart status    Whether Orbit comes back by itself, and what would stop it
  sbar-orbit autostart enable    Start with the desktop, by both paths a desktop might honour
  sbar-orbit autostart disable   Stop starting by itself, on every path
  sbar-orbit status              Sessions, tabs and windows, for a glance or a bar
  sbar-orbit status --watch      Print a line whenever that changes
  sbar-orbit panel               Dock the session mark to the desktop edge
                                 (click it to show desktop sessions)
  sbar-orbit settings            Show the native configuration notice; use config to edit
  sbar-orbit native-settings     Open protected/full native controls and the action log
  sbar-orbit native-prepare DIR  Prepare native owner configuration without activation
  sbar-orbit native-refresh      Renew the compositor binding after Hyprland restarted, keeping your mode
  sbar-orbit native-leases       List native application leases; "release ID" frees one whose worker is gone
  sbar-orbit native-plugin status|load|unload|resume DIR
                                Inspect or load the fixed prepared native plugin
  sbar-orbit config list         Every setting, its value and its default
  sbar-orbit config search WORD  Find a setting by name, meaning, English or Arabic
  sbar-orbit config get KEY
  sbar-orbit config set KEY VALUE
                                 Takes effect immediately on a running panel
  sbar-orbit update status       Which version is running, and which are prepared
  sbar-orbit update on           Check daily, prepare, and activate when no session is open
  sbar-orbit update off          Stop updating by itself, with no network and no broker needed
  sbar-orbit update check        Ask the registry what is newer, and whether it is eligible yet
  sbar-orbit update stage        Prepare the eligible version beside the running one, activate nothing
  sbar-orbit update activate VERSION
                                 Point the launcher at a prepared version and restart
                                 (refused while a session is open, rolls back if it will not start)
  sbar-orbit update prune        Remove prepared versions nothing would roll back to
  sbar-orbit clean               Remove workspaces no running broker owns
  sbar-orbit doctor              Inspect the running broker and its resources
  sbar-orbit applications        Discover installed and running application metadata
  sbar-orbit diagnostics         Prepare a private report and a GitHub issue link, also offline
  sbar-orbit preflight           Check prerequisites without starting applications
  sbar-orbit session create      Create an owned private desktop session
  sbar-orbit session create fedora
  sbar-orbit session list
  sbar-orbit session observe ID  One screenshot and what the session shows
  sbar-orbit session native-view ID APP WINDOW [--frames COUNT]
                                 Show the owned target and agent cursor in a native GTK window
  sbar-orbit session pause ID    Pause agent actions for the session
  sbar-orbit session resume ID
  sbar-orbit session journal ID  Every decision the session made
  sbar-orbit session restore ID [SEQUENCE]
                                 Return to a restore point, when allowed
  sbar-orbit session stop ID
  sbar-orbit act ID JSON         Execute a session action
  sbar-orbit connector-config    Print MCP configuration for this broker
  sbar-orbit connector-config --no-launcher
                                 For a host that cannot spawn the launcher itself
  sbar-orbit mcp                 Run the stdio MCP adapter
  sbar-orbit usage on|off|status [CONVERSATION_ID]
                                 Control this conversation, not the shared service
  sbar-orbit session observe ID --metadata
                                 Tabs/windows and pointer without screenshot capture
  sbar-orbit session observe ID --output /absolute/new-image.jpg
                                 Save original image bytes; print metadata, no base64

Client commands default to the managed socket; ORBIT_SOCKET selects another broker.
Set ORBIT_CONVERSATION_ID uniquely per conversation to share CLI/MCP usage state.
Requires Bun. Original native opening currently requires Linux and Hyprland.
Private desktops and standalone browser sessions are retired. Native handoff requires a matching prepared plugin.
Native desktop adapters for Windows and macOS are not implemented. See docs/desktop-only.md.
HELP
    ;;
  preflight)
    shift
    exec "$orbit_bun" run "$orbit_root/scripts/preflight.ts" "$@"
    ;;
  install)
    shift
    exec "$orbit_bun" run "$orbit_root/scripts/limited.ts" "$orbit_bun" run "$orbit_root/scripts/install.ts" "$@"
    ;;
  service)
    shift
    exec "$orbit_bun" run "$orbit_root/scripts/service.ts" "$@"
    ;;
  autostart)
    exec "$orbit_bun" run "$orbit_root/scripts/service.ts" "$@"
    ;;
  config)
    shift
    [ "$orbit_uname" = "Linux" ] || orbit_refuse_desktop config
    # No GTK and no broker: this works over ssh, inside a service, and while the panel is not running.
    exec /usr/bin/python3 "$orbit_root/desktop/orbit_settings.py" "$@"
    ;;
  settings)
    shift
    [ "$orbit_uname" = "Linux" ] || orbit_refuse_desktop settings
    # Hands the request to the running panel when there is one, and starts one when there is not.
    exec /usr/bin/python3 "$orbit_root/desktop/panel.py" --settings "$@"
    ;;
  serve)
    shift
    exec "$orbit_bun" run "$orbit_root/scripts/limited.ts" "$orbit_bun" run "$orbit_root/src/cli.ts" serve "$@"
    ;;
  status)
    shift
    case " $* " in *" --watch "*) exec "$orbit_bun" run "$orbit_root/src/status.ts" --watch ;; esac
    exec "$orbit_bun" run "$orbit_root/src/cli.ts" status "$@"
    ;;
  panel)
    shift
    [ "$orbit_uname" = "Linux" ] || orbit_refuse_desktop panel
    # The panel is the person's own desktop surface, so it runs outside the shared budget.
    exec /usr/bin/python3 "$orbit_root/desktop/panel.py" "$@"
    ;;
  connector-config|mcp)
    orbit_entry=$1
    shift
    # The path this launcher was actually invoked by, absolute but NOT resolved through symlinks. An
    # installation links a stable name in a prefix and switches the source underneath it on every
    # upgrade, so the link is what generated agent configuration has to name; resolving it would
    # write down the one version that happens to be current and break on the next one. Exported only
    # here so connector setup can name the stable launcher path.
    export ORBIT_LAUNCHER="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")"
    exec "$orbit_bun" run "$orbit_root/src/$orbit_entry.ts" "$@"
    ;;
  native-settings|native-prepare|native-plugin|native-refresh)
    [ "$orbit_uname" = "Linux" ] || orbit_refuse_desktop "$1"
    exec "$orbit_bun" run "$orbit_root/scripts/limited.ts" "$orbit_bun" run "$orbit_root/src/cli.ts" "$@"
    ;;
  session)
    if [ "${2:-}" = "native-view" ]; then
      [ "$orbit_uname" = "Linux" ] || orbit_refuse_desktop native-view
      exec "$orbit_bun" run "$orbit_root/scripts/limited.ts" "$orbit_bun" run "$orbit_root/src/cli.ts" "$@"
    fi
    exec "$orbit_bun" run "$orbit_root/src/cli.ts" "$@"
    ;;
  *) exec "$orbit_bun" run "$orbit_root/src/cli.ts" "$@" ;;
esac
